# ATLAS Environment Configuration

# Server Ports
PORT=3007
FRONTEND_PORT=5180
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres:///atlas?host=/var/run/postgresql
TEST_DATABASE_URL=postgres:///atlas_test?host=/var/run/postgresql

# Blaaiz Provider API Configuration
# Base URLs:
#   Development: https://api-dev.blaaiz.com
#   Production:  https://api-prod.blaaiz.com
BLAAIZ_BASE_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=your_blaaiz_sandbox_client_id
BLAAIZ_CLIENT_SECRET=your_blaaiz_sandbox_client_secret
BLAAIZ_WEBHOOK_SECRET=your_blaaiz_webhook_signing_secret
BLAAIZ_BUSINESS_WALLET_ID=b18ed308-5ac5-4e9e-bb16-8c03ec2d3c01

# Feature Toggles
ENABLE_BLAAIZ_EMULATOR=true
APP_SECRET=atlas_development_secret_key_32bytes_minimum_length
